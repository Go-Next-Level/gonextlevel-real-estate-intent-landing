---
interface Props {
  href?: string;
  showWordmark?: boolean;
}
const { href = "/", showWordmark = true } = Astro.props;
---
<a href={href} aria-label="Real Estate Intent — home" style="display:inline-flex; align-items:center; gap:10px;">
  <span class="logo-mark" aria-hidden="true">
    <svg viewBox="0 0 64 64" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- R letterform — stem + bowl with inner counter -->
      <path fill-rule="evenodd" clip-rule="evenodd" fill="currentColor" d="
        M 11 6
        L 11 58
        L 21 58
        L 21 38
        L 30 38
        L 49 58
        L 61 58
        L 39 36
        A 15 15 0 0 0 39 6
        L 11 6
        Z
        M 21 14
        L 36 14
        A 7 7 0 0 1 36 28
        L 21 28
        Z
      "/>
      <!-- Left slope of the roof — mirrors the R's leg into a chevron -->
      <path fill="currentColor" d="
        M 3 58
        L 25 36
        L 31 43
        L 16 58
        Z
      "/>
      <!-- 4 window panes centered below the roof peak -->
      <rect x="28" y="46" width="3.4" height="3.4" fill="currentColor"/>
      <rect x="32.6" y="46" width="3.4" height="3.4" fill="currentColor"/>
      <rect x="28" y="50.6" width="3.4" height="3.4" fill="currentColor"/>
      <rect x="32.6" y="50.6" width="3.4" height="3.4" fill="currentColor"/>
    </svg>
  </span>
  {showWordmark && (
    <span style="display:flex; flex-direction:column;">
      <span class="wordmark-1">RealEstate<span style="color:var(--brand-2);">Intent</span></span>
      <span class="wordmark-2">Audience intelligence</span>
    </span>
  )}
</a>
