---
import Logo from './Logo.astro';
import { footerNavigation } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer-grid">
      <div class="footer-brand">
        <Logo />
        <p>Person-level behavioral intent data and audience activation for real estate and mortgage teams.</p>
      </div>
      {footerNavigation.map((group) => (
        <nav aria-label={`${group.label} links`} class="footer-group">
          <span>{group.label}</span>
          {group.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      ))}
    </div>
    <div class="site-footer-bottom">
      <span>© 2026 Real Estate Intent · a service of Next Level Web Design LLC</span>
      <span><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/acceptable-use/">Acceptable use</a> · <a href="/compliance/">Compliance</a></span>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: 72px 0 30px; border-top: 1px solid var(--border); background: #08080a; }
  .site-footer-grid { display: grid; grid-template-columns: minmax(240px, 1.7fr) repeat(3, minmax(140px, 1fr)); gap: 52px; }
  .footer-brand p { max-width: 330px; margin-top: 20px; color: var(--text-3); font-size: 14px; line-height: 1.6; }
  .footer-group { display: grid; align-content: start; gap: 4px; }
  .footer-group span { margin-bottom: 12px; color: var(--text-3); font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; }
  .footer-group a { min-height: 38px; display: flex; align-items: center; color: var(--text-2); font-size: 13px; }
  .footer-group a:hover { color: var(--brand-2); }
  .site-footer-bottom { display: flex; justify-content: space-between; gap: 24px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--border); color: var(--text-3); font-family: var(--mono); font-size: 10px; letter-spacing: .02em; }
  .site-footer-bottom a:hover { color: var(--text); }
  @media (max-width: 820px) { .site-footer-grid { grid-template-columns: repeat(2, 1fr); } .footer-brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .site-footer-grid { grid-template-columns: 1fr; } .footer-brand { grid-column: auto; } .site-footer-bottom { flex-direction: column; } }
</style>

